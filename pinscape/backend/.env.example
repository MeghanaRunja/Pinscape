# ─── Pinterest OAuth ──────────────────────────────────────────────────────────
# Create an app at https://developers.pinterest.com/apps/
# Add your redirect URI there under "Redirect URIs"
PINTEREST_CLIENT_ID=your_pinterest_client_id_here
PINTEREST_CLIENT_SECRET=your_pinterest_client_secret_here

# Must match exactly what you registered in the Pinterest developer portal.
PINTEREST_REDIRECT_URI=http://localhost:8000/auth/pinterest/callback

# Where the backend redirects after a successful OAuth exchange.
# Mobile (default): Expo custom scheme the app's openAuthSessionAsync watches for.
# Web frontend:     http://localhost:3000/auth-success
OAUTH_SUCCESS_REDIRECT=pinscape://auth-success

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Security ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
# REQUIRED in production — app refuses to start if still the default.
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" to enable strict startup validation
ENVIRONMENT=development
